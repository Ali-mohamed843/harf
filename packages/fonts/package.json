{
  "name": "@harf/fonts",
  "version": "0.1.0",
  "description": "Arabic font metric presets: recommended line heights, optical size adjustments, safe padding and mixed-script fallback chains.",
  "license": "MIT",
  "author": "Harf contributors",
  "homepage": "https://github.com/Ali-mohamed843/harf/tree/main/packages/fonts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ali-mohamed843/harf.git",
    "directory": "packages/fonts"
  },
  "bugs": {
    "url": "https://github.com/Ali-mohamed843/harf/issues"
  },
  "keywords": [
    "arabic",
    "fonts",
    "typography",
    "line-height",
    "cairo",
    "tajawal",
    "rtl"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist .turbo",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:exports": "publint --strict && attw --pack ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "publint": "^0.3.2"
  }
}
