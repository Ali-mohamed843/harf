{
  "name": "@harf/next",
  "version": "0.0.0",
  "description": "Next.js App Router adapter for Harf: server-side dir on <html>, RSC-safe direction access, and a Tailwind plugin for mirroring and bidi utilities.",
  "license": "MIT",
  "author": "Harf contributors",
  "homepage": "https://github.com/harf-rtl/harf/tree/main/packages/next#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harf-rtl/harf.git",
    "directory": "packages/next"
  },
  "bugs": {
    "url": "https://github.com/harf-rtl/harf/issues"
  },
  "keywords": [
    "rtl",
    "arabic",
    "next",
    "nextjs",
    "app-router",
    "rsc",
    "tailwind",
    "i18n"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./tailwind": {
      "import": {
        "types": "./dist/tailwind.d.ts",
        "default": "./dist/tailwind.js"
      },
      "require": {
        "types": "./dist/tailwind.d.cts",
        "default": "./dist/tailwind.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "server/",
    "tailwind/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/use-client.mjs dist/index.js dist/index.cjs",
    "dev": "tsup --watch",
    "clean": "rimraf dist .turbo",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:exports": "publint --strict && attw --pack ."
  },
  "dependencies": {
    "@harf/core": "workspace:*",
    "@harf/react": "workspace:*",
    "@harf/fonts": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/react": "^18.3.18",
    "next": "^15.1.4",
    "publint": "^0.3.2",
    "react": "^18.3.1"
  },
  "typesVersions": {
    "*": {
      "server": [
        "./dist/server.d.ts"
      ],
      "tailwind": [
        "./dist/tailwind.d.ts"
      ]
    }
  }
}
