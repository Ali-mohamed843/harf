{
  "name": "@harf/native",
  "version": "0.1.0",
  "description": "React Native adapter for Harf: direction switching without an app restart, logical StyleSheet integration, icon mirroring, gesture and animation helpers.",
  "license": "MIT",
  "author": "Harf contributors",
  "homepage": "https://github.com/Ali-mohamed843/harf/tree/main/packages/native#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ali-mohamed843/harf.git",
    "directory": "packages/native"
  },
  "bugs": {
    "url": "https://github.com/Ali-mohamed843/harf/issues"
  },
  "keywords": [
    "rtl",
    "arabic",
    "react-native",
    "expo",
    "i18nmanager",
    "bidi",
    "direction"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./limits": {
      "import": {
        "types": "./dist/limits.d.ts",
        "default": "./dist/limits.js"
      },
      "require": {
        "types": "./dist/limits.d.cts",
        "default": "./dist/limits.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "limits/",
    "testing/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist .turbo",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "check:exports": "publint --strict && attw --pack ."
  },
  "dependencies": {
    "@harf/core": "workspace:*",
    "@harf/fonts": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.73.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^7.26.0",
    "@react-native/babel-preset": "^0.76.9",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.18",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "publint": "^0.3.2",
    "react": "^18.3.1",
    "react-native": "^0.76.9",
    "react-test-renderer": "^18.3.1"
  },
  "typesVersions": {
    "*": {
      "limits": [
        "./dist/limits.d.ts"
      ],
      "testing": [
        "./dist/testing.d.ts"
      ]
    }
  }
}
