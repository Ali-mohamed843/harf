{
  "name": "@harf/core",
  "version": "0.0.0",
  "description": "Framework-agnostic RTL and Arabic logic: direction resolution, logical style transforms, bidi isolation, numerals, dates and currency. Zero runtime dependencies.",
  "license": "MIT",
  "author": "Harf contributors",
  "homepage": "https://github.com/harf-rtl/harf/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harf-rtl/harf.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/harf-rtl/harf/issues"
  },
  "keywords": [
    "rtl",
    "arabic",
    "bidi",
    "i18n",
    "direction",
    "logical-properties"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist .turbo",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  }
}
