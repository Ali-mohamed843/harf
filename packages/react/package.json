{
  "name": "@harf/react",
  "version": "0.0.0",
  "description": "React (web) adapter for Harf: DirectionProvider, useDirection, useLogicalStyles, <Bidi>.",
  "license": "MIT",
  "author": "Harf contributors",
  "homepage": "https://github.com/harf-rtl/harf/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harf-rtl/harf.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/harf-rtl/harf/issues"
  },
  "keywords": [
    "rtl",
    "arabic",
    "react",
    "bidi",
    "i18n",
    "direction"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "testing/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist .turbo",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:exports": "publint --strict && attw --pack ."
  },
  "dependencies": {
    "@harf/core": "workspace:*",
    "@harf/fonts": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "publint": "^0.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "typesVersions": {
    "*": {
      "testing": [
        "./dist/testing.d.ts"
      ]
    }
  }
}
