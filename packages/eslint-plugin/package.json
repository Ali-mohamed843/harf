{
  "name": "@harf/eslint-plugin",
  "version": "0.0.0",
  "description": "ESLint rules with autofix for RTL correctness: no physical style properties, no physical Tailwind classes, require bidi isolation.",
  "license": "MIT",
  "author": "Harf contributors",
  "homepage": "https://github.com/harf-rtl/harf/tree/main/packages/eslint-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harf-rtl/harf.git",
    "directory": "packages/eslint-plugin"
  },
  "bugs": {
    "url": "https://github.com/harf-rtl/harf/issues"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "rtl",
    "arabic",
    "i18n",
    "tailwind",
    "logical-properties"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist .turbo",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "eslint": ">=8.57.0"
  },
  "devDependencies": {
    "@types/eslint": "^9.6.1"
  }
}
