{
  "name": "@harf/eslint-plugin",
  "version": "0.0.0",
  "description": "ESLint rules with autofix for RTL correctness: no physical style properties, no physical Tailwind classes, require bidi isolation.",
  "license": "MIT",
  "author": "Harf contributors",
  "homepage": "https://github.com/Ali-mohamed843/harf/tree/main/packages/eslint-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ali-mohamed843/harf.git",
    "directory": "packages/eslint-plugin"
  },
  "bugs": {
    "url": "https://github.com/Ali-mohamed843/harf/issues"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "rtl",
    "arabic",
    "i18n",
    "tailwind",
    "logical-properties"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist .turbo",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:exports": "publint --strict && attw --pack ."
  },
  "peerDependencies": {
    "eslint": ">=8.57.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/eslint": "^9.6.1",
    "@types/estree": "^1.0.6",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "publint": "^0.3.2"
  }
}
